# Copy this file to .env and fill in real values.
# .env is gitignored — never commit actual secrets.

# Optional. If unset, the AI explanation layer falls back to a
# deterministic template built from the same findings — the app is
# fully functional without this key.
ANTHROPIC_API_KEY=

# Optional. Only needed if you wire up persistent storage beyond the
# bundled CSV/JSON sample data.
DATABASE_URL=

# Optional. Where the Streamlit frontend looks for the FastAPI backend.
AUDIT_API_BASE_URL=http://127.0.0.1:8000
